<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>ProjectEnchanter</RootNamespace>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <!-- Tests live in their own project; don't compile them here. -->
        <Compile Remove="tests\**" />
        <!-- Trained model parameters (written by tools/train_rune_model.py). -->
        <EmbeddedResource Include="resources\rune_model\*.csv" />
    </ItemGroup>
</Project>
